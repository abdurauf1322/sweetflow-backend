{
  "name": "qandchi-bola",
  "productName": "Qandchi Bola",
  "version": "1.0.0",
  "description": "Qandchi Bola - Distribyutsiya va Kassa Tizimi",
  "main": "src/server.js",
  "scripts": {
    "start": "node node_modules/prisma/build/index.js db push --accept-data-loss && node src/server.js",
    "dev": "nodemon src/server.js",
    "postinstall": "node node_modules/prisma/build/index.js generate",
    "prisma:generate": "node node_modules/prisma/build/index.js generate",
    "prisma:migrate": "npx prisma migrate dev"
  },
  "keywords": [
    "b2b",
    "wholesale",
    "distribution",
    "prisma",
    "express",
    "node"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "node-cron": "^3.0.3",
    "node-telegram-bot-api": "^1.2.0",
    "pg": "^8.23.0",
    "zod": "^3.23.8",
    "prisma": "^5.18.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "nodemonConfig": {
    "ignore": [
      "frontend/*",
      "uploads/*",
      "node_modules/*",
      "prisma/*.db"
    ]
  }
}
